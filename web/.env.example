# =============================================================================
# ADQS Exam v2 — Teacher Web environment
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# On Vercel, set these under Project → Settings → Environment Variables.
#
# TWO RULES THAT CAUSE MOST DEPLOYMENT FAILURES:
#
#   1. `NEXT_PUBLIC_*` variables are INLINED INTO THE BROWSER BUNDLE at build
#      time. Changing one requires a REDEPLOY, not just a restart. A variable
#      without that prefix is `undefined` in the browser — it exists only on the
#      server. Every variable below states which side reads it.
#
#   2. NEVER give a secret a `NEXT_PUBLIC_` prefix. It would be shipped to every
#      visitor in plain text.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — connection
# -----------------------------------------------------------------------------
# Project URL. Read by the browser, the server, and the middleware, so it MUST
# have the `NEXT_PUBLIC_` prefix.
# Dashboard → Project Settings → Data API → Project URL
#   local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase renamed its API keys. Both naming schemes are accepted, and the
# publishable form is preferred; only ONE of these two is required.
#
#   Modern (recommended): Dashboard → Project Settings → API Keys → Publishable key
#   Legacy              : Dashboard → Project Settings → API Keys → anon public
#
# This key is PUBLIC BY DESIGN. It ships to the browser and grants nothing on
# its own: every teacher-owned table is guarded by RLS on `auth.uid()`, and
# every student action goes through a SECURITY DEFINER RPC.
#   local publishable: sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Supabase — server-only secret
# -----------------------------------------------------------------------------
# SERVICE-ROLE / SECRET key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
#
#   Modern: Dashboard → Project Settings → API Keys → Secret key
#   Legacy: Dashboard → Project Settings → API Keys → service_role
#
# Supabase bypasses RLS for this key, so it can read every tenant's rows.
#
# NOTE: the current application does NOT call it — every privileged operation
# goes through a SECURITY DEFINER RPC invoked with the caller's own session.
# It is listed because the platform needs it provisioned and because any future
# admin/back-office path must read it from one audited place.
#   local secret: sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Cloudflare Worker — DOCX extraction
# -----------------------------------------------------------------------------
# Full URL of the Worker's extraction endpoint, INCLUDING the path.
# Read by the server-side proxy route (src/app/api/extract/route.ts), never by
# the browser: the request carries a secret header, so it cannot be a browser
# call. Trailing slashes are stripped automatically.
#   local: http://localhost:8787/api/v1/extract   (`npx wrangler dev` in v2/worker)
NEXT_PUBLIC_EXTRACTOR_API_URL=http://localhost:8787/api/v1/extract

# Shared secret forwarded to the Worker in the `X-Internal-Secret` header.
# SERVER ONLY. Must equal the Worker's own INTERNAL_SECRET.
# Leave EMPTY for local development: the Worker bypasses the header check when
# its own binding is unset, which is what `wrangler dev` + .dev.vars gives you.
EXTRACTOR_INTERNAL_SECRET=local-dev-secret


# -----------------------------------------------------------------------------
# AI extraction model
# -----------------------------------------------------------------------------
# Default AI model offered in the upload dialog's model picker.
#
# This is a HINT, not the authority: selecting the "default" option sends NO
# model id, and the Worker then applies its own `AI_MODEL_NAME` binding. Change
# the Worker's variable to retarget every caller at once; set this one only to
# display (and pre-select) the effective model in the picker.
#
# The `NEXT_PUBLIC_` prefix is REQUIRED: the picker lives in a client component,
# so a bare variable would be `undefined` in the browser and silently ignored.
# The bare name is still read as a server-side fallback.
#   examples: gemini-3.5-flash-lite | gemini-3.8-flash | gemma-4-31b-it
NEXT_PUBLIC_AI_MODEL_NAME=gemini-3.5-flash-lite
# AI_MODEL_NAME=gemini-3.5-flash-lite

# AI provider id, lower-cased. Defaults to `gemini`, the only provider the
# Worker's Engine 2 implements. It selects which curated model shortlist the
# picker offers, so it cannot advertise models the deployment cannot call.
NEXT_PUBLIC_AI_PROVIDER=gemini
# AI_PROVIDER=gemini


# -----------------------------------------------------------------------------
# Student SPA deep links
# -----------------------------------------------------------------------------
# Origin (scheme + host, NO trailing slash) of the student SPA on Cloudflare
# Pages. Used to build the exam join link + QR code and the Tree of Knowledge
# join URL — both open the SPA's index with a query parameter.
#
# When EMPTY, the current origin is used, which is exactly what local
# development wants. In production it MUST be set: otherwise the QR code points
# at the teacher app, where the student views do not exist.
#   example: https://adqs-exam-student.pages.dev
NEXT_PUBLIC_STUDENT_APP_URL=
