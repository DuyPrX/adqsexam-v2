NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
NEXT_PUBLIC_EXTRACTOR_API_URL=http://localhost:8787/api/v1/extract
EXTRACTOR_INTERNAL_SECRET=your_secret
# Origin of the student SPA (Cloudflare Pages). Used by the Tree of Knowledge
# projector to build the join URL encoded in the student-facing QR code. When
# unset, the projector falls back to its own origin, which is what local
# development wants.
NEXT_PUBLIC_STUDENT_APP_URL=https://your-student-app.pages.dev
